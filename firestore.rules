rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && ((resource.data.userId == null && request.resource.data.userId == request.auth.uid) || resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Settings collection
    match /settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Goals collection
    match /goals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Cards collection (legacy)
    match /cards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // User Banks collection
    match /userBanks/{bankId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Budgets collection
    match /budgets/{budgetId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Investments collection
    match /investments/{investmentId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // CMS collection - public read, admin-only write
    match /cms/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'jonathalimax@gmail.com';
    }

    // Coupons collection - public read (for validation), admin-only write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'jonathalimax@gmail.com';
    }

    // Access control collection - read for login check, write for authenticated users
    match /access/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pending payments - created by cloud functions
    match /pending_payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if false; // Only cloud functions can write
    }

    // Purchases - created by cloud functions
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && request.auth.token.email == resource.data.email;
      allow write: if false; // Only cloud functions can write
    }

    // Bills collection
    match /bills/{billId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Bill reminders (postponement history)
    match /bill_reminders/{reminderId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Users collection - for WhatsApp bot access
    match /users/{userId} {
      // Users can read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow Firebase Admin SDK (WhatsApp bot) to read all users
      allow read: if request.auth != null;

      // Sub-collections for user bills
      match /bills/{billId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Allow Firebase Admin SDK (WhatsApp bot) to read/update bills
        allow read, update: if request.auth != null;
      }
    }

    // Analytics collection - track anonymous visitor events on landing page
    match /analytics/{eventId} {
      // Anyone can create/write analytics events (for anonymous tracking)
      allow create, write: if true;
      // Only admin can read analytics data
      allow read: if request.auth != null && request.auth.token.email == 'jonathalimax@gmail.com';
    }
  }
}
