rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Helper function: Get access document
    function getAccessDoc() {
      return get(/databases/$(database)/documents/access/allowed_emails);
    }

    // Helper function: Check if user is the owner of the data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function: Check if user has shared access (email in emails list)
    function hasSharedAccess() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/access/allowed_emails) &&
             (
               request.auth.token.email.lower() in getAccessDoc().data.allowedEmailsList ||
               getAccessDoc().data.emails.hasAny([
                 {'email': request.auth.token.email.lower(), 'role': 'read'},
                 {'email': request.auth.token.email.lower(), 'role': 'write'}
               ])
             );
    }

    // Helper function: Get the owner's UID from access document
    function getOwnerId() {
      return getAccessDoc().data.ownerId;
    }

    // Helper function: Check if user has write access (email in writeEmailsList or emails list with write role)
    function hasWriteAccess() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/access/allowed_emails) &&
             (
               request.auth.token.email.lower() in getAccessDoc().data.writeEmailsList ||
               getAccessDoc().data.emails.hasAny([
                 {'email': request.auth.token.email.lower(), 'role': 'write'}
               ])
             );
    }

    // Helper function: Check if user can read this data (owner or shared user viewing owner's data)
    function canReadData(dataUserId) {
      return isOwner(dataUserId) ||
             (hasSharedAccess() && dataUserId == getOwnerId());
    }

    // Helper function: Check if user can write this data (owner or shared user with write role)
    function canWriteData(dataUserId) {
      return isOwner(dataUserId) ||
             (hasWriteAccess() && dataUserId == getOwnerId());
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasWriteAccess() && request.resource.data.userId == getOwnerId()));
      allow update: if request.auth != null && canWriteData(resource.data.userId);
      allow delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // Settings collection
    match /settings/{userId} {
      allow read: if request.auth != null && canReadData(userId);
      allow write: if request.auth != null && canWriteData(userId);
    }

    // Planner collection - personal financial plan, scoped by userId
    match /planner/{userId} {
      allow read: if request.auth != null && canReadData(userId);
      allow write: if request.auth != null && canWriteData(userId);
    }

    // Goals collection
    match /goals/{goalId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasWriteAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // Cards collection (legacy)
    match /cards/{cardId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasWriteAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // User Banks collection
    match /userBanks/{bankId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasWriteAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // Budgets collection
    match /budgets/{budgetId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasWriteAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // Investments collection
    match /investments/{investmentId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasWriteAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // CMS collection - public read, admin-only write
    match /cms/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'jonathalimax@gmail.com';
    }

    // Pricing configuration - public read (for display), admin-only write
    match /config/pricing {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Coupons collection - public read (for validation), admin-only write
    match /config/coupons/{coupon=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Legacy coupons collection (deprecated but keeping for backward compatibility)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Access control collection - read for login check, write for authenticated users
    match /access/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pending payments - created by cloud functions
    // Public read: allows unauthenticated Firestore onSnapshot on the specific
    // doc after Pix checkout (contains only email, amount, status — non-sensitive)
    match /pending_payments/{paymentId} {
      allow read: if true;
      allow write: if false; // Only cloud functions can write
    }

    // Purchases - created by cloud functions
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.token.email == resource.data.email);
      allow write: if false; // Only cloud functions can write
    }

    // Bills collection
    match /bills/{billId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasSharedAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // Bill reminders (postponement history)
    match /bill_reminders/{reminderId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasSharedAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // Users collection - for WhatsApp bot access
    match /users/{userId} {
      // Users can read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow Firebase Admin SDK (WhatsApp bot) to read all users
      allow read: if request.auth != null;

      // Sub-collections for user bills
      match /bills/{billId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Allow Firebase Admin SDK (WhatsApp bot) to read/update bills
        allow read, update: if request.auth != null;
      }
    }

    // Analytics collection - track anonymous visitor events on landing page
    match /analytics/{eventId} {
      // Anyone can create/write analytics events (for anonymous tracking)
      allow create, write: if true;
      // Only admin can read analytics data
      allow read: if request.auth != null && request.auth.token.email == 'jonathalimax@gmail.com';
    }

    // Import History collection - tracks processed import files
    match /importHistory/{importId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasWriteAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // Import Stats collection - aggregated import statistics per user
    // Document ID is the userId, similar to settings collection
    match /importStats/{userId} {
      allow read: if request.auth != null && canReadData(userId);
      allow write: if request.auth != null && canWriteData(userId);
    }

    // User Categorization Rules - learned patterns from user categorizations
    match /userCategorizationRules/{ruleId} {
      allow read: if request.auth != null && canReadData(resource.data.userId);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || (hasWriteAccess() && request.resource.data.userId == getOwnerId()));
      allow update, delete: if request.auth != null && canWriteData(resource.data.userId);
    }

    // AI Quota tracking - tracks daily AI usage per user
    // Document ID is the userId
    match /aiQuota/{userId} {
      allow read: if request.auth != null && canReadData(userId);
      allow write: if request.auth != null && canWriteData(userId);
    }

    // Admin access list — only admin email docs are readable by the owner
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false; // managed via Admin SDK only
    }

    // Onboarding runs — admin writes via CF; admin can read
    match /onboardingRuns/{runId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if false; // written by Cloud Functions only

      match /logs/{logId} {
        allow read: if request.auth != null && isAdmin();
        allow write: if false; // written by Cloud Functions only
      }
    }

    // Import issues — submitted by users via Cloud Function; admin read/write
    match /importIssues/{issueId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // Leads — admin read/write; deny all others
    match /leads/{email} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // Service accounts — admin read only (writes via CF/Admin SDK)
    match /serviceAccounts/{username} {
      allow read: if request.auth != null && isAdmin();
      allow write: if false;
    }

    // Admin email audit logs — admin read only
    match /admin_email_logs/{docId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if false;
    }

    // Landing stats — admin read; write only via Cloud Functions
    match /landing_stats/{day} {
      allow read: if request.auth != null && isAdmin();
      allow write: if false;
    }
  }
}
