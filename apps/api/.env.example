DATABASE_URL=postgres://postgres:dev@localhost:5432/realwise
JWT_SECRET=local-dev-secret-at-least-32-chars
JWT_REFRESH_SECRET=local-dev-refresh-secret-at-least-32
API_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=br.com.realwise.web
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
NODE_ENV=development
MERCADOPAGO_ACCESS_TOKEN=TEST-your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=TEST-your-mercadopago-public-key
MP_ACCESS_TOKEN=TEST-your-mercado-pago-access-token
MP_PUBLIC_KEY=TEST-your-mercado-pago-public-key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@realwise.com.br
# Display name shown in the inbox (always applied, even if EMAIL_FROM already has one)
EMAIL_FROM_NAME=Realwise
IMPORT_ISSUES_EMAIL_TO=support@realwise.com.br

# AI assistant (chat). Without OPENROUTER_API_KEY the chat endpoints return 503.
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# Optional overrides; defaults shown. Verify the model slug on https://openrouter.ai/models
# LLM_MODEL_CHAT=anthropic/claude-sonnet-5.5
# LLM_MODEL_INSIGHTS=anthropic/claude-sonnet-5.5
# LLM_MONTHLY_BUDGET_USD=5
